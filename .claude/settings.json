{
  "permissions": {
    "allow": [
      "Bash(python -X utf8 -B tools/ci_gate.py)",
      "Bash(python -X utf8 -B tools/ci_gate.py *)",
      "Bash(python3 -X utf8 -B tools/ci_gate.py)",
      "Bash(python3 -X utf8 -B tools/ci_gate.py *)",
      "Bash(python -X utf8 -B tools/test_*.py)",
      "Bash(python3 -X utf8 -B tools/test_*.py)",
      "Bash(python -m unittest)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest)",
      "Bash(python3 -m unittest *)",
      "Bash(actionlint)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__linear__list_comments",
      "mcp__Linear__get_issue",
      "mcp__Linear__list_issues",
      "mcp__Linear__list_comments"
    ],
    "ask": [
      "Bash(gh * -R*)",
      "Bash(gh * --repo*)",
      "Bash(gh *://*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"'",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
