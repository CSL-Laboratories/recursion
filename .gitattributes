# Shell scripts must stay LF — they run on the Linux VPS (CRLF breaks the shebang).
*.sh text eol=lf
loop/supervisor/run.sh text eol=lf
scripts/notify.sh text eol=lf
scripts/install-cron.sh text eol=lf
# Parser-read registry: the last column must not grow a CR on Windows checkouts.
state/portfolio.tsv text eol=lf
# This byte-exact Git patch intentionally contains the required single-space context markers.
docs/audits/recursion-v2-phase0-live-dirty-canonical.patch text eol=lf -whitespace
# Sealed receipt hashes are byte-level evidence and must survive cross-platform checkouts.
docs/audits/recursion-v2-phase0-transition-receipts/*.json text eol=lf

# Controller policy and provenance helpers are authenticated against Git blob bytes.
scripts/validate-gate.py text eol=lf
scripts/resolve-engine.py text eol=lf
scripts/provider-egress-profiles.json text eol=lf
scripts/capacity-pools.json text eol=lf
scripts/engines/*.json text eol=lf

# Research-lane intakes are hash-pinned: delivered bytes must survive cross-platform checkouts.
docs/v3/research-lane/capability-composition-20261002d/** text eol=lf
docs/v3/research-lane/ios-android-20261002/** text eol=lf
docs/v3/research-lane/core-language-control-surfaces-20261002/** text eol=lf
