.env
.env.local
# .env backups shaped like .env.bak.<epoch> end in digits, so `*.bak` below misses them — and
# one was found sitting unignored on the box (2026-08-27), one `git add -A` from a secret leak.
.env.bak*
*.local
node_modules/
__pycache__/
*.pyc
.venv/
*.log
loop/logs/
.DS_Store
# Claude Code: keep worktrees, local settings and local hooks untracked; track
# only the shared settings, cloud-session hook and shared skills.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
!.claude/hooks/guard-substitution.sh
!.claude/skills/
.claude/skills/*
!.claude/skills/proceed-or-escalate/
.tmp/

# Local tool binaries (downloaded, not committed): TLA+ tools for FU-03
tools/tlaplus/

# TLC state store output (generated, potentially very large)
**/results/metadir_*/

# internal runtime dotfiles (BOARD.md itself IS tracked; its sidecars are not)
state/.board.tsv
state/.board-tick
state/.recursion-snapshot.txt
state/.openrouter-usage.json
state/.work.lock/
state/.locks/
# build-loop: worktrees + build artifacts (loop/auto must never track these;
# build output is committed on loop/work/<id> from inside the worktree instead)
.worktrees/
.next/
out/
dist/
*.bak

# Runtime event log (taskctl). Append-only and unbounded, and every test run that exercises
# work.sh appends to it — work.selftest.sh alone leaked four selftest-* events into a review
# branch. It is durable state ON THE BOX, read live by the board/digest, not repo history;
# committing it would grow the repo per tick and make every branch conflict on it.
# Retention/rotation is a B5 decision.
state/events.jsonl

# Hermes decision journal + durable queue projections. Runtime state on the BOX, like
# state/events.jsonl: appended every decision cycle, read live by the actuator and the digest.
# Tracking it would grow the repo per tick and conflict on every branch.
state/decisions.jsonl
state/decision-queue/
# Legacy pre-Phase-3 singleton. It is never read or written; keep an undeployed box clean until
# a separately authorized paused deployment quarantines the old runtime artifact.
state/.decision-latest.json

# Phase 2 durable action queue. The JSON projections are recoverable current state and the JSONL
# file is their append-only lifecycle history; both are runtime state, not review-branch content.
state/actions/
state/action-events.jsonl
state/pilot-requests/
state/plans/
state/pilot-windows/
state/runs/
state/assignments/
state/evidence/
state/recovery/
state/deliveries/
state/delivery-events.jsonl
state/notification-events/
state/notification-event-events.jsonl
state/notification-audit-events.jsonl
state/notification-recovery-events.jsonl
state/transport-evidence/
state/reports/
state/usage/
state/event-archive/
state/jsonl-quarantine/
state/jsonl-index/
state/instructions/
# Remote adapter runtime state (v2 Phase 6/7): durable attempt journals, vendor session
# projections, and Grok Bot proposals. Same class as state/runs/ -- state ON the box, not in
# its history. state/remote/<backend>/attempts.jsonl is the record of truth; the JSON files
# beside it are projections of it.
state/remote/

# Escalation index (taskctl). Same class as state/events.jsonl above: appended by every cycle
# AND by every test run that exercises work.sh, read live by the board and the digest. The
# human-readable escalation is in the tracked state/INBOX.md; this file carries only the dedup
# identity and sighting counts, so losing it costs a counter — while tracking it would make
# every review branch conflict on it.
state/escalations.tsv

# Runtime scratch. resync.sh reports a repo as DIRTY when the tree has uncommitted changes, and
# these three directories made /opt/recursion permanently dirty — a signal that is always red is
# a signal nobody reads, which is worse than no signal.
#   .hermes/        the hermes CLI's own plan store
#   loop/prompts/   scratch prompts handed to a reviewer model
#   loop/artifacts/ arm reports. STAGING, not the canonical home: an arm commits its note into
#                   the TARGET repo on loop/work/<id>. Verified before adding this line — all 5
#                   notes present were byte-identical (md5) to their copies in
#                   the project origin/main, so nothing unique is being hidden.
.hermes/
loop/prompts/
loop/artifacts/
state/.intake-watermark

# ★ THE KILL SWITCH IS RUNTIME STATE, NOT HISTORY. state/PAUSE was tracked, and it existed on
# loop/auto and not on master — so `git checkout master`, an ordinary thing to do while reviewing,
# DELETED it and silently unpaused the box (2026-08-06, with AUTO_DRAIN=1). A safety control whose
# presence depends on which branch is checked out is not a safety control. Same class as
# events.jsonl: state ON the box, not in its history.
state/PAUSE

# Harness run records (CSL-27). Runtime state, not review history.
.recursion/
