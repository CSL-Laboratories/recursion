#!/usr/bin/env bash
# recursion — operator surface for the supervisor (architecture.md "Observability" + escape hatch).
# Symlink into PATH on the box:  ln -sf /opt/recursion/bin/recursion /usr/local/bin/recursion
set -euo pipefail
ROOT="${RECURSION_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
cd "$ROOT"
CMD="${1:-help}"; shift || true

latest_brief(){ ls -t state/briefs/*.md 2>/dev/null | grep -v gitkeep | head -1; }

case "$CMD" in
  board|status)  bash scripts/board.sh render; echo; bash scripts/board-summary.sh ;;
  cycle)         bash scripts/cycle.sh "${1:-}" ;;
  run)           bash loop/supervisor/run.sh "${1:?job (morning|heartbeat)}" ;;
  dispatch)      bash scripts/dispatch.sh "$@" ;;
  tasks)         bash scripts/tasks.sh "${1:-}" ;;
  work)          bash scripts/work.sh "${1:-}" ;;
  resolve)       bash scripts/resolve.sh "$@" ;;
  # `assist` is the RETURN path: resolve/requeue close or reopen a task, but neither carries an
  # ANSWER back to the arm, so a requeued task re-blocks on the same question. See scripts/assist.sh.
  assist)        if [ "$#" -ge 2 ]; then bash scripts/assist.sh answer "$@"; else bash scripts/assist.sh show "${1:?task id}"; fi ;;
  assists)       bash scripts/assist.sh list "${1:-open}" ;;
  author)        bash scripts/author.sh "$@" ;;
  intake)        bash scripts/intake.sh "${1:-poll}" "${2:-}" ;;
  instructions)  bash scripts/intake.sh open ;;
  pilot)
    SUB="${1:-help}"; shift || true
    case "$SUB" in
      status|context|topic|route|repo|logs|evidence) python3 scripts/project-pilot.py "$SUB" "$@" ;;
      verify) python3 scripts/project-pilot.py verify-registry ;;
      *) echo "usage: recursion pilot <status PROJECT|context PROJECT|repo PROJECT [PATH]|logs PROJECT [FILE]|evidence PROJECT [FILE]|topic THREAD|route PROJECT REQUEST [TARGET]|verify>"; exit 2 ;;
    esac ;;
  capacity)      bash scripts/capacity.sh "${1:-report}" ;;
  resync)        bash scripts/resync.sh "${1:-status}" "${2:-}" ;;
  topics)        bash scripts/topics.sh "${1:-list}" ;;
  decide)        bash scripts/hermes-decide.sh "${1:-}" ;;
  requeue)       bash scripts/resolve.sh --requeue "$@" ;;
  drain)         bash scripts/drain.sh ;;
  conduct)       bash scripts/conduct.sh ;;
  plan)          bash scripts/plan.sh "${1:?workstream}" ;;
  reflect)       bash scripts/reflect.sh ;;
  publish)       bash scripts/publish.sh "$@" ;;
  proposals)     cat state/PROPOSALS.md 2>/dev/null || echo "(no proposals yet)" ;;
  lessons)       cat state/LESSONS.md 2>/dev/null || echo "(no lessons yet)" ;;
  pause)         bash scripts/pause.sh "$@" ;;
  resume)        bash scripts/resume.sh ;;
  inbox)         cat state/INBOX.md ;;

  # --- escalation identity + leases (taskctl) ------------------------------------------
  # `resolve` closes a TASK; `resolve-esc` closes an ESCALATION. They are different objects:
  # a supervisor escalation has no task behind it, which is why it had no id and duplicated.
  escalations|esc)  bash scripts/taskctl.sh esc-list "${1:-open}" ;;
  resolve-esc)      bash scripts/taskctl.sh esc-resolve "${1:?escalation id, e.g. esc-0001}" "${2:-}" ;;
  reap)             bash scripts/taskctl.sh reap ;;
  events)           tail -n "${1:-30}" state/events.jsonl 2>/dev/null || echo "(no events yet)" ;;
  brief)         B="$(latest_brief)"; [ -n "$B" ] && { echo "# $B"; echo; cat "$B"; } || echo "(no brief yet)" ;;
  logs)          tail -n "${2:-40}" "$(ls -t loop/logs/*.log 2>/dev/null | head -1)" 2>/dev/null || echo "(no logs)" ;;

  open)
    # Assemble a context handle for a workstream — the deep-dive escape hatch.
    WS="${1:?workstream (a state/projects/<name> stem)}"
    PF="state/projects/$WS.md"
    echo "=== RECURSION CONTEXT HANDLE — workstream: $WS ==="
    echo "generated: $(date -u +%FT%TZ)"
    echo
    if [ -f "$PF" ]; then echo "--- project status ($PF) ---"; cat "$PF"; else
      echo "(no project file $PF; available:)"; ls state/projects/*.md 2>/dev/null | sed 's#state/projects/##;s#\.md##'; fi
    echo; echo "--- decisions mentioning '$WS' ---"
    grep -niE "$WS" state/DECISIONS.md 2>/dev/null | head -20 || echo "(none)"
    echo; echo "--- open inbox items mentioning '$WS' ---"
    grep -niE "$WS" state/INBOX.md 2>/dev/null | head -20 || echo "(none)"
    echo; echo "--- to go deep on a PC ---"
    echo "cd into the workstream's repo and open an interactive Claude Code (Opus) conductor session,"
    echo "then paste this handle. Your decision lands in state/INBOX.md / DECISIONS.md; the loop reads it next cycle."
    ;;

  help|*)
    cat <<EOF
recursion <command>

  board | status      the live registry (state/BOARD.md) + build-loop summary — what's running now
  brief               print the latest daily brief
  inbox               pending escalations (things waiting on you)
  logs [N]            tail the newest loop log (default 40 lines)
  cycle [force]       run one supervised tick now (heartbeat -> brief-if-signalled)
  run <job>           run one job (morning | heartbeat)
  dispatch <ws> <engine> <prompt_file> [model] [label]
                      spawn an execution arm (engine: hermes | claude | openrouter)
  tasks [status]      list the build-loop queue (state/tasks/), optionally by status
  pilot <subcommand>  bounded topic/project context and live status (read-only operator surface)
  work [id]           run the executor: build a task, verify acceptance, auto-commit
                      the green result to loop/work/<id> (no id -> first queued task)
  resolve <id> [note] close an escalation: stamp a RESOLVED note to INBOX + status=resolved
  requeue <id> [note] re-open a task for another run (status -> queued)
  drain               run queued tasks one at a time under bounds (the continuation engine)
  conduct             run queued tasks IN PARALLEL — one per workstream, capped (parallel)
  plan <workstream>   emit a task for the next unchecked roadmap item (state/roadmaps/<ws>.md)
  reflect             the box reviews itself: one improvement -> proposals, one lesson -> memory
  proposals           print the self-improvement queue (state/PROPOSALS.md — human decides)
  lessons             print durable operational lessons (state/LESSONS.md — re-fed into arms)
  open <workstream>   assemble a context handle for a PC deep-dive (escape hatch)
  pause [reason]      kill switch ON   (state/PAUSE — halts autonomous action)
  resume              kill switch OFF
EOF
    ;;
esac
