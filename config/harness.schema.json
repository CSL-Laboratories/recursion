{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csl-laboratories.example/recursion/harness.schema.json",
  "title": "Recursion harness config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "budgets", "review", "routing", "providers"],
  "properties": {
    "version": {"const": 1},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_cost"],
      "properties": {
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "max_cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rounds", "accept_unreviewed"],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 0},
        "accept_unreviewed": {"type": "boolean"}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_capabilities", "preference"],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preference": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cooldown_seconds": {"type": "integer", "minimum": 0},
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "enabled", "capabilities", "argv", "timeout_seconds"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
