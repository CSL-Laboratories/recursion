[Unit]
Description=Recursion provider-only HTTP CONNECT proxy
Requires=recursion-provider-network.service
BindsTo=recursion-provider-network.service
After=recursion-provider-network.service network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
Group=root
ExecStartPre=/opt/recursion/scripts/provider-network.sh namespace-check
ExecStart=/opt/recursion/scripts/provider-connect-proxy.py serve --namespace /run/netns/recursion-provider-only --listen-port 18080 --allow api.anthropic.com:443 --allow api2.cursor.sh:443 --allow api.cursor.com:443 --allow agentn.global.api5.cursor.sh:443 --allow agentn.global.api5lat.cursor.sh:443 --allow agentn.global.api5geo.cursor.sh:443 --drop-user recursion-provider-proxy --concurrency 16
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
LimitNOFILE=256
TasksMax=64
MemoryHigh=128M
MemoryMax=256M
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
