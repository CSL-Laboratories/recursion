  "lost": [
    {
      "name": "a whole float reads as an integer",
      "json": "2.0",
      "python": "2.0",
      "desktop": "2",
      "why": "JSON.parse gives the number 2 for both 2 and 2.0; Python keeps 2.0 a float"
    },
    {
      "name": "negative zero reads as zero",
      "json": "-0.0",
      "python": "-0.0",
      "desktop": "0",
      "why": "JSON.parse gives -0 for both -0 and -0.0; Python reads -0 as the integer 0 and -0.0 as a float"
    },
    {
      "name": "a whole float in exponent form below 2**53 reads as an integer",
      "json": "1e15",
      "python": "1000000000000000.0",
      "desktop": "1000000000000000",
      "why": "JSON.parse gives the same number for 1e15 and 1000000000000000"
    },
    {
      "name": "an integer past 2**53 has lost digits",
      "json": "9007199254740993",
      "python": "9007199254740993",
      "desktop": "9007199254740992.0",
      "why": "a JavaScript number holds no integer past 2**53 exactly; Python's int does"
    },
    {
      "name": "an integer-like key moves to the front",
      "json": "{\"b\": 1, \"1\": 2}",
      "python": "{'b': 1, '1': 2}",
      "desktop": "{'1': 2, 'b': 1}",
      "why": "a JavaScript object lists integer-like keys first; Python's dict keeps the order of the text"
    }
  ]
