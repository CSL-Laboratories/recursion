-- hidden/test_roman.py --
import unittest

from numerals.roman import from_roman, to_roman


class RomanTests(unittest.TestCase):
    def test_known_values(self):
        for number, text in [(1, "I"), (4, "IV"), (9, "IX"), (14, "XIV"), (40, "XL"), (90, "XC"),
                             (400, "CD"), (1994, "MCMXCIV"), (3999, "MMMCMXCIX")]:
            self.assertEqual(to_roman(number), text)
            self.assertEqual(from_roman(text), number)

    def test_round_trip(self):
        for number in range(1, 4000):
            self.assertEqual(from_roman(to_roman(number)), number)

    def test_out_of_range(self):
        for number in (0, 4000, -1):
            with self.assertRaises(ValueError):
                to_roman(number)

    def test_invalid_numerals(self):
        for text in ("", "IIII", "VX", "IC", "MMMM", "ABC"):
            with self.assertRaises(ValueError):
                from_roman(text)
-- solution/numerals/roman.py --
_VALUES = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"),
           (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]


def to_roman(number):
    if not isinstance(number, int) or not 1 <= number <= 3999:
        raise ValueError(f"out of range: {number!r}")
    out = []
    for value, symbol in _VALUES:
        count, number = divmod(number, value)
        out.append(symbol * count)
    return "".join(out)


def from_roman(text):
    if not isinstance(text, str) or not text:
        raise ValueError("empty numeral")
    total, i = 0, 0
    for value, symbol in _VALUES:
        while text.startswith(symbol, i):
            total += value
            i += len(symbol)
    if i != len(text) or not 1 <= total <= 3999 or to_roman(total) != text:
        raise ValueError(f"not a canonical numeral: {text!r}")
    return total
