    raise NotImplementedError


def decode(text):
    raise NotImplementedError
-- hidden/test_codec.py --
import unittest

from rle.codec import decode, encode


class CodecTests(unittest.TestCase):
    def test_encode(self):
        self.assertEqual(encode("aaabcc"), "3a1b2c")
        self.assertEqual(encode("x" * 12), "12x")

    def test_decode(self):
        self.assertEqual(decode("3a1b2c"), "aaabcc")
        self.assertEqual(decode("12x"), "x" * 12)

    def test_round_trip(self):
        for text in ("", "a", "abba", "zzzzzzzzzzzzzzzzzzzzzzzz y", "  !!"):
            self.assertEqual(decode(encode(text)), text)

    def test_digits_refused(self):
        with self.assertRaises(ValueError):
            encode("a1")

    def test_malformed(self):
        for text in ("a", "3", "0a", "2a3"):
            with self.assertRaises(ValueError):
                decode(text)
-- solution/rle/codec.py --
import re

_PAIR = re.compile(r"([1-9][0-9]*)(\D)", re.DOTALL)


def encode(text):
    if any(ch.isdecimal() for ch in text):
        raise ValueError("text contains a digit")
    out = []
    i = 0
    while i < len(text):
        j = i
        while j < len(text) and text[j] == text[i]:
            j += 1
        out.append(f"{j - i}{text[i]}")
        i = j
    return "".join(out)


def decode(text):
    out = []
    pos = 0
    while pos < len(text):
        match = _PAIR.match(text, pos)
        if not match:
            raise ValueError(f"malformed at position {pos}: {text!r}")
        out.append(match.group(2) * int(match.group(1)))
        pos = match.end()
    return "".join(out)
