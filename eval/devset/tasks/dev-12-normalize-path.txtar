-- hidden/test_norm.py --
import unittest

from pathkit.norm import normalize


class NormalizeTests(unittest.TestCase):
    def test_absolute(self):
        self.assertEqual(normalize("/a//b/./c/../d/"), "/a/b/d")

    def test_relative_parents_kept(self):
        self.assertEqual(normalize("a/../../b"), "../b")

    def test_root_parent(self):
        self.assertEqual(normalize("/../x"), "/x")
        self.assertEqual(normalize("/.."), "/")

    def test_empty_and_dot(self):
        self.assertEqual(normalize(""), ".")
        self.assertEqual(normalize("./"), ".")
        self.assertEqual(normalize("a/.."), ".")

    def test_double_slash_root(self):
        self.assertEqual(normalize("//a"), "/a")
-- solution/pathkit/norm.py --
def normalize(path):
    absolute = path.startswith("/")
    parts = []
    for part in path.split("/"):
        if part in ("", "."):
            continue
        if part == "..":
            if parts and parts[-1] != "..":
                parts.pop()
            elif not absolute:
                parts.append("..")
            continue
        parts.append(part)
    joined = "/".join(parts)
    if absolute:
        return "/" + joined
    return joined or "."
