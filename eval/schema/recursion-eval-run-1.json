{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recursion-eval-run/1",
  "title": "recursion-eval-run/1: one suite run of one arm, every trial in it",
  "description": "Lane EVAL's record (eval/record.py checks the same rules and the cross-trial ones: the plan hash, rows per plan, the replacement graph, finite numbers). Unknown values are null and counted unknown, never 0. No aggregate is stored: eval/analyze.py recomputes every score from the trials. Every planned trial has a row. arm.settings_sha256 hashes the settings both arms of a comparison share.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"label": {"const": "dev"}}, "required": ["label"]},
     "then": {"properties": {"suite": {"properties": {"split": {"const": "dev"}}}}},
     "else": {"properties": {"suite": {"properties": {"split": {"const": "held_out"}}}}}},
    {"if": {"properties": {"label": {"enum": ["screen", "pilot", "full"]}}, "required": ["label"]},
     "then": {"properties": {"plan": {"properties": {"k": {"minimum": 5}}},
                             "arm": {"properties": {"engine": {"not": {"const": "standin"}}}}}}},
    {"if": {"properties": {"label": {"enum": ["screen", "pilot", "full"]}}, "required": ["label"]},
     "then": {"properties": {"suite": {"properties": {"frozen": {"const": true}}}}}}
  ],
  "required": ["schema", "record_id", "label", "suite", "arm", "runner", "protocol", "plan", "environment",
               "started_at", "finished_at", "trials"],
  "properties": {
    "schema": {"const": "recursion-eval-run/1"},
    "record_id": {"$ref": "#/$defs/text"},
    "label": {"enum": ["dev", "shakedown", "screen", "pilot", "full"]},
    "started_at": {"$ref": "#/$defs/text"},
    "finished_at": {"$ref": "#/$defs/text_or_null"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "split", "frozen", "manifest_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "split": {"enum": ["dev", "held_out"]},
        "frozen": {"type": "boolean"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "engine", "engine_version", "model", "route", "effort", "settings_sha256"],
      "properties": {
        "name": {"enum": ["direct", "recursion"]},
        "engine": {"$ref": "#/$defs/text"},
        "engine_version": {"$ref": "#/$defs/text_or_null"},
        "model": {"$ref": "#/$defs/text_or_null"},
        "route": {"$ref": "#/$defs/text_or_null"},
        "effort": {"$ref": "#/$defs/text_or_null"},
        "settings_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "pinned", "evaluated_commit"],
      "properties": {
        "version": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pinned": {"type": "boolean"},
        "evaluated_commit": {"$ref": "#/$defs/text_or_null"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_sha256", "analysis_sha256"],
      "properties": {
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "analysis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "attempts_per_task", "replacements_per_task", "seed", "tasks", "plan_sha256"],
      "properties": {
        "k": {"type": "integer", "minimum": 1},
        "attempts_per_task": {"type": "integer", "minimum": 1},
        "replacements_per_task": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cluster", "task_sha256", "created_at"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "cluster": {"$ref": "#/$defs/text_or_null"},
              "task_sha256": {"$ref": "#/$defs/sha256"},
              "created_at": {"$ref": "#/$defs/text_or_null"}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {
        "python": {"$ref": "#/$defs/text"},
        "platform": {"$ref": "#/$defs/text"}
      }
    },
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "text_or_null": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256_or_null": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "count_or_null": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "seconds_or_null": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "int_or_null": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "bool_or_null": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "task_id", "attempt", "run_id", "grade", "error", "engine", "usage", "timing",
                   "artifacts", "scratch"],
      "properties": {
        "trial_id": {"$ref": "#/$defs/text"},
        "task_id": {"$ref": "#/$defs/text"},
        "run_id": {"$ref": "#/$defs/text_or_null"},
        "attempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "planned", "replacement_for"],
          "properties": {
            "index": {"type": "integer", "minimum": 1},
            "planned": {"type": "boolean"},
            "replacement_for": {"$ref": "#/$defs/text_or_null"}
          },
          "if": {"properties": {"planned": {"const": true}}},
          "then": {"properties": {"replacement_for": {"type": "null"}}},
          "else": {"properties": {"replacement_for": {"$ref": "#/$defs/text"}}}
        },
        "grade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "grader_id", "grader_sha256", "details_sha256", "exit"],
          "properties": {
            "verdict": {"enum": ["resolved", "unresolved", "not_graded"]},
            "grader_id": {"$ref": "#/$defs/text_or_null"},
            "grader_sha256": {"$ref": "#/$defs/sha256_or_null"},
            "details_sha256": {"$ref": "#/$defs/sha256_or_null"},
            "exit": {"$ref": "#/$defs/int_or_null"}
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "tier", "detail"],
          "properties": {
            "tier": {"enum": ["none", "agent", "infra", "grader", "unknown"]},
            "class": {"enum": [null, "tests_failed", "timeout", "engine_crash", "no_result", "engine_error",
                               "setup_failed", "start_tree_mismatch", "engine_missing", "vendor_limit",
                               "auth_failed", "grader_failed", "no_tests_ran", "not_run", "unclassified"]},
            "detail": {"$ref": "#/$defs/text_or_null"}
          },
          "allOf": [
            {"if": {"properties": {"tier": {"const": "none"}}},
             "then": {"properties": {"class": {"type": "null"}}}},
            {"if": {"properties": {"tier": {"const": "agent"}}},
             "then": {"properties": {"class": {"enum": ["tests_failed", "timeout", "engine_crash", "no_result",
                                                        "engine_error"]}}}},
            {"if": {"properties": {"tier": {"const": "infra"}}},
             "then": {"properties": {"class": {"enum": ["setup_failed", "start_tree_mismatch", "engine_missing",
                                                        "vendor_limit", "auth_failed"]}}}},
            {"if": {"properties": {"tier": {"const": "grader"}}},
             "then": {"properties": {"class": {"enum": ["grader_failed", "no_tests_ran"]}}}},
            {"if": {"properties": {"tier": {"const": "unknown"}}},
             "then": {"properties": {"class": {"enum": ["not_run", "unclassified"]}}}}
          ]
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit", "signal", "timed_out", "claimed_done"],
          "properties": {
            "exit": {"$ref": "#/$defs/int_or_null"},
            "signal": {"$ref": "#/$defs/int_or_null"},
            "timed_out": {"type": "boolean"},
            "claimed_done": {"$ref": "#/$defs/bool_or_null"}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uncached_input", "cache_write", "cache_read", "output", "cost", "cost_unit", "cost_basis",
                       "source"],
          "properties": {
            "uncached_input": {"$ref": "#/$defs/count_or_null"},
            "cache_write": {"$ref": "#/$defs/count_or_null"},
            "cache_read": {"$ref": "#/$defs/count_or_null"},
            "output": {"$ref": "#/$defs/count_or_null"},
            "cost": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
            "cost_unit": {"$ref": "#/$defs/text_or_null"},
            "cost_basis": {"enum": ["billed", "reported_not_billed", "unknown"]},
            "source": {"enum": [null, "engine_output", "usage_events"]}
          },
          "allOf": [
            {"if": {"properties": {"cost": {"type": "number"}}, "required": ["cost"]},
             "then": {"properties": {"cost_unit": {"type": "string"}}}},
            {"if": {"properties": {"cost": {"type": "null"}}, "required": ["cost"]},
             "then": {"properties": {"cost_basis": {"const": "unknown"}}}}
          ]
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "engine_seconds", "grading_seconds"],
          "properties": {
            "wall_seconds": {"$ref": "#/$defs/seconds_or_null"},
            "engine_seconds": {"$ref": "#/$defs/seconds_or_null"},
            "grading_seconds": {"$ref": "#/$defs/seconds_or_null"}
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch_sha256", "patch_bytes", "patch_empty", "files_changed", "test_log_sha256",
                       "trajectory_sha256", "trajectory_format", "retained", "artifact_error"],
          "if": {"properties": {"retained": {"const": true}}, "required": ["retained"]},
          "then": {"properties": {"artifact_error": {"type": "null"}}},
          "properties": {
            "artifact_error": {"$ref": "#/$defs/text_or_null"},
            "patch_sha256": {"$ref": "#/$defs/sha256_or_null"},
            "patch_bytes": {"$ref": "#/$defs/count_or_null"},
            "patch_empty": {"$ref": "#/$defs/bool_or_null"},
            "files_changed": {"$ref": "#/$defs/count_or_null"},
            "test_log_sha256": {"$ref": "#/$defs/sha256_or_null"},
            "trajectory_sha256": {"$ref": "#/$defs/sha256_or_null"},
            "trajectory_format": {"$ref": "#/$defs/text_or_null"},
            "retained": {"type": "boolean"}
          }
        },
        "scratch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tmpdir", "xdg_runtime_dir", "removed"],
          "properties": {
            "tmpdir": {"$ref": "#/$defs/text_or_null"},
            "xdg_runtime_dir": {"$ref": "#/$defs/text_or_null"},
            "removed": {"$ref": "#/$defs/bool_or_null"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"grade": {"properties": {"verdict": {"const": "resolved"}}}}},
         "then": {"properties": {"error": {"properties": {"tier": {"const": "none"}}}}}},
        {"if": {"properties": {"grade": {"properties": {"verdict": {"const": "unresolved"}}}}},
         "then": {"properties": {"error": {"anyOf": [
           {"properties": {"tier": {"const": "agent"}}},
           {"properties": {"tier": {"const": "infra"}, "class": {"enum": ["vendor_limit", "auth_failed"]}}}
         ]}}}},
        {"if": {"properties": {"grade": {"properties": {"verdict": {"const": "not_graded"}}}}},
         "then": {"properties": {"error": {"properties": {"tier": {"enum": ["infra", "grader", "unknown"]}}}}}}
      ]
    }
  }
}
