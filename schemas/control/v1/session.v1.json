{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.v1.json",
  "title": "session.v1: one session and its turns",
  "x-version": "1.0-draft.1",
  "description": "PUBLIC record, and the row lane SESSIONS stores. Meanings that are frozen with this record: a RUN is one supervised unit with its own Stop. A TURN is one input and the engine's work until it yields. With a driver that declares multi_turn, several turns of a session share one run_id (one worker stays alive between turns); with any other driver each turn has its own run. Stop acts on a run. Interrupt acts on a turn. A session has at most one live unit. 'idle' with a worker that is alive is a persistent worker waiting for input; 'live' is a turn in progress; 'stop_pending' is a Stop that is not confirmed, and no new turn starts while it lasts; 'ended' is final. No token, cookie or key appears in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "tenant", "principal", "parent_session_id", "spawn_kind", "state", "workspace", "route", "engine_session_id", "worker", "active_turn_id", "turns", "budget", "revision", "created_at"],
  "properties": {
    "session_id": {"$ref": "common.v1.json#/$defs/session_id"},
    "tenant": {"$ref": "common.v1.json#/$defs/tenant"},
    "principal": {
      "description": "Who started the session.",
      "$ref": "common.v1.json#/$defs/principal"
    },
    "parent_session_id": {
      "description": "The session this one was forked from or is a child of; null for a root.",
      "anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/session_id"}]
    },
    "spawn_kind": {
      "description": "root: started by a user. fork: a copy of the parent at one of its turns. child: started by the parent session itself (delegation).",
      "enum": ["root", "fork", "child"]
    },
    "state": {"enum": ["idle", "live", "stop_pending", "ended"]},
    "workspace": {
      "description": "null when the session has no workspace: its units then run in the engine's own home, as run.start does today.",
      "anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/workspace"}]
    },
    "route": {"$ref": "common.v1.json#/$defs/route"},
    "engine_session_id": {
      "description": "The engine's own id for the conversation, used to resume or fork it; null until the engine reports one. Untrusted text.",
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "worker": {
      "description": "The session's unit, or null when it has none. alive is what the daemon last knew of that unit.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["run_id", "alive"],
      "properties": {
        "run_id": {"$ref": "common.v1.json#/$defs/run_id"},
        "alive": {"type": "boolean"}
      }
    },
    "active_turn_id": {
      "description": "The turn in progress, or null.",
      "anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/turn_id"}]
    },
    "turns": {
      "description": "Every turn of the session, oldest first. index starts at 0 and rises by one.",
      "type": "array",
      "items": {"$ref": "#/$defs/turn"}
    },
    "budget": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/budget"}]},
    "revision": {"$ref": "common.v1.json#/$defs/revision"},
    "created_at": {"$ref": "common.v1.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"required": ["spawn_kind"], "properties": {"spawn_kind": {"const": "root"}}},
      "then": {"properties": {"parent_session_id": {"type": "null"}}},
      "else": {"properties": {"parent_session_id": {"type": "string"}}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "idle"}}},
      "then": {"properties": {"active_turn_id": {"type": "null"}}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "live"}}},
      "then": {"properties": {"active_turn_id": {"type": "string"}, "worker": {"type": "object"}}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "stop_pending"}}},
      "then": {"properties": {"worker": {"type": "object"}}}
    },
    {
      "if": {"required": ["state"], "properties": {"state": {"const": "ended"}}},
      "then": {"properties": {"active_turn_id": {"type": "null"}, "worker": {"type": "null"}}}
    }
  ],
  "$defs": {
    "turn_state": {
      "description": "queued: accepted, and the engine's work has not begun. running: in progress. ended: the engine yielded. interrupted: an interrupt ended it. failed: it could not start or the engine failed. stopped: a Stop ended its run.",
      "enum": ["queued", "running", "interrupted", "ended", "failed", "stopped"]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "index", "run_id", "state", "started_at", "ended_at"],
      "properties": {
        "turn_id": {"$ref": "common.v1.json#/$defs/turn_id"},
        "index": {"type": "integer", "minimum": 0},
        "run_id": {
          "description": "The run the turn's work happens in; null until the turn is bound to one.",
          "anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/run_id"}]
        },
        "state": {"$ref": "#/$defs/turn_state"},
        "started_at": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/timestamp"}]},
        "ended_at": {"anyOf": [{"type": "null"}, {"$ref": "common.v1.json#/$defs/timestamp"}]}
      },
      "allOf": [
        {
          "if": {"required": ["state"], "properties": {"state": {"const": "queued"}}},
          "then": {"properties": {"started_at": {"type": "null"}, "ended_at": {"type": "null"}}}
        },
        {
          "if": {"required": ["state"], "properties": {"state": {"const": "running"}}},
          "then": {"properties": {"run_id": {"type": "string"}, "started_at": {"type": "string"}, "ended_at": {"type": "null"}}}
        },
        {
          "if": {"required": ["state"], "properties": {"state": {"enum": ["interrupted", "ended", "failed", "stopped"]}}},
          "then": {"properties": {"ended_at": {"type": "string"}}}
        },
        {
          "if": {"required": ["state"], "properties": {"state": {"enum": ["interrupted", "ended", "stopped"]}}},
          "then": {"properties": {"run_id": {"type": "string"}, "started_at": {"type": "string"}}}
        }
      ]
    }
  }
}
