{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csl-laboratories.com/recursion/schemas/wire-vocab-draft.schema.json",
  "title": "Recursion public wire contract vocabulary",
  "x-status": "draft-pending-rule-h-acceptance",
  "x-issue": "CSL-238",
  "description": "DRAFT rendering of docs/v3/PUBLIC-WIRE-CONTRACTS.md. Non-normative until a rule-H human receipt accepts the exact digest on CSL-238. Language-neutral: the vocabulary describes documents, not transports.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/wire_identity_ref" },
    { "$ref": "#/$defs/wire_event_envelope" },
    { "$ref": "#/$defs/wire_command_outcome" },
    { "$ref": "#/$defs/wire_version_advertisement" }
  ],
  "$defs": {
    "public_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 162,
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._~-]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "type_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 132,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*@[1-9][0-9]{0,2}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pos_int": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "reason_code": {
      "enum": [
        "stale-epoch",
        "duplicate-command-conflict",
        "replay-gap-continuation",
        "authority-mismatch",
        "capability-denied",
        "policy-denied",
        "fence-violation",
        "precondition-failed",
        "budget-exceeded",
        "paused",
        "unsupported-version",
        "unknown-record"
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "refusal_class"],
      "properties": {
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "refusal_class": { "enum": ["permanent", "retryable"] },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "refusal_class": { "const": "permanent" } }
          },
          "then": {
            "not": { "required": ["retry_after_seconds"] }
          }
        }
      ]
    },
    "wire_identity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "object_type", "id", "version", "content_digest"],
      "properties": {
        "type": { "const": "WireIdentityRef@1" },
        "object_type": { "$ref": "#/$defs/token" },
        "id": { "$ref": "#/$defs/public_id" },
        "version": { "$ref": "#/$defs/pos_int" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "wire_event_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "stream_id",
        "sequence",
        "event_type",
        "schema_ref",
        "payload_digest"
      ],
      "properties": {
        "type": { "const": "WireEventEnvelope@1" },
        "event_id": { "$ref": "#/$defs/public_id" },
        "stream_id": { "$ref": "#/$defs/public_id" },
        "sequence": { "$ref": "#/$defs/seq" },
        "event_type": { "$ref": "#/$defs/event_type" },
        "schema_ref": { "$ref": "#/$defs/type_version" },
        "payload_digest": { "$ref": "#/$defs/digest" },
        "emitted_at": { "$ref": "#/$defs/utc_timestamp" },
        "causation_id": { "$ref": "#/$defs/public_id" }
      }
    },
    "wire_command_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command_id", "command_digest", "outcome"],
      "properties": {
        "type": { "const": "WireCommandOutcome@1" },
        "command_id": { "$ref": "#/$defs/public_id" },
        "command_digest": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["accepted", "duplicate", "conflict", "refused"] },
        "refusal": { "$ref": "#/$defs/refusal" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "refused" } }
          },
          "then": { "required": ["refusal"] },
          "else": {
            "not": { "required": ["refusal"] }
          }
        }
      ]
    },
    "wire_version_advertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vocabulary_version", "supported", "sunset"],
      "properties": {
        "type": { "const": "WireVersionAdvertisement@1" },
        "vocabulary_version": { "$ref": "#/$defs/pos_int" },
        "supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/type_version" },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "x-sorted-set": true
        },
        "sunset": {
          "type": "array",
          "items": { "$ref": "#/$defs/type_version" },
          "maxItems": 256,
          "uniqueItems": true,
          "x-sorted-set": true
        },
        "preferred": { "$ref": "#/$defs/type_version" }
      },
      "x-preferred-in-supported": true
    }
  }
}
