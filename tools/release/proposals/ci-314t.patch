       - name: Provider-free gate
         run: python -X utf8 -B tools/ci_gate.py --force
+
+  # Free: the core suite on free-threaded CPython 3.14, GIL off, with cryptography
+  # (lane RELEASE, C9 (a)). Allocated exactly like linux-tests and run beside it;
+  # the required linux shell needs its success. TMPDIR is a fresh folder under
+  # /tmp, outside the home folder: runner.temp lies under /home/runner, and the
+  # subscription-route guard refuses a route home inside the operator's home,
+  # which turns about 180 route tests red. XDG_RUNTIME_DIR is a fresh tmpfs
+  # folder and the session bus is unset, so no test reaches the runner's user
+  # manager and the real-manager tests skip.
+  core-314t:
+    name: core 3.14t
+    needs: [preflight, settle]
+    if: >
+      always() && !cancelled() &&
+      needs.preflight.result == 'success' &&
+      needs.preflight.outputs.paid == 'true' &&
+      needs.preflight.outputs.run_full == 'true' &&
+      (github.event_name != 'pull_request' || github.event.pull_request.draft == false) &&
+      ((github.event_name == 'pull_request' && github.event.action == 'synchronize' && needs.settle.result == 'success') ||
+       (!(github.event_name == 'pull_request' && github.event.action == 'synchronize') && needs.settle.result == 'skipped'))
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.14t"
+
+      - name: Install dependencies
+        working-directory: ${{ runner.temp }}
+        env:
+          REQUIREMENTS_314T: ${{ github.workspace }}/tools/release/requirements-ci-314t.txt
+        shell: bash
+        run: 'python -P -m pip install --only-binary=:all: --require-hashes -r "$REQUIREMENTS_314T"'
+
+      - name: Core suite, free-threaded with the GIL off
+        shell: bash
+        run: |
+          set -eu
+          python -X gil=0 -B -c 'import sys, sysconfig, cryptography; assert sysconfig.get_config_var("Py_GIL_DISABLED") == 1, "not a free-threaded build"; assert not sys._is_gil_enabled(), "the GIL is on"; print(sys.version, "cryptography", cryptography.__version__)'
+          scratch_tmp=$(mktemp -d /tmp/recursion-ci-tmp.XXXXXX)
+          scratch_run=$(mktemp -d /dev/shm/recursion-ci-run.XXXXXX)
+          chmod 700 "$scratch_tmp" "$scratch_run"
+          env -u DBUS_SESSION_BUS_ADDRESS TMPDIR="$scratch_tmp" XDG_RUNTIME_DIR="$scratch_run" PYTHONPATH=core \
+            python -X gil=0 -B -m unittest discover -s core -t core
