@@ -301,6 +301,30 @@ class CoreGateTests(unittest.TestCase):
         self.assertEqual(str(raised.exception), "byte-compile failed")


+class FileTimeoutTests(unittest.TestCase):
+    def test_file_timeouts_only_raise_the_limit_of_files_the_gate_runs(self) -> None:
+        run = set(ci_gate.assert_tests_accounted())
+        self.assertTrue(ci_gate.FILE_TIMEOUTS)
+        for rel, seconds in ci_gate.FILE_TIMEOUTS.items():
+            self.assertIn(rel, run)
+            self.assertGreater(seconds, ci_gate.RUN_TIMEOUT)
+
+    def test_run_suite_gives_each_file_its_limit(self) -> None:
+        limits: dict[str, int] = {}
+
+        def record(rel: str, *, root: Path | None = None, timeout: int = ci_gate.RUN_TIMEOUT) -> None:
+            limits[rel] = timeout
+
+        with mock.patch.object(ci_gate, "run_lightweight"), mock.patch.object(ci_gate, "byte_compile"), \
+                mock.patch.object(ci_gate, "run_program"), \
+                mock.patch.object(ci_gate, "run_test_file", side_effect=record), mock.patch("builtins.print"):
+            ci_gate.run_suite()
+        self.assertEqual(limits["tools/test_claude_fixer_publish.py"], 300)
+        self.assertEqual(limits["tools/test_ci_gate.py"], ci_gate.RUN_TIMEOUT)
+        others = {rel: limit for rel, limit in limits.items() if rel not in ci_gate.FILE_TIMEOUTS}
+        self.assertEqual(set(others.values()), {ci_gate.RUN_TIMEOUT})
+
+
 class TestInventoryTests(unittest.TestCase):
