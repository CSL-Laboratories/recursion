-RENDERED_SHA_LINK_TAGS = frozenset(("a", "tt", "code"))
-RENDERED_SHA_TEXT_RE = re.compile(r"\s*(?:[\w.-]+/[\w.-]+@)?[0-9a-f]{7,40}\s*", re.IGNORECASE)
