-def _skip_html_tag_space(visible: str, index: int) -> int:
-    """Skip spaces, tabs, and at most one line ending (CommonMark 6.6)."""
-    length = len(visible)
-    saw_break = False
-    while index < length:
-        char = visible[index]
-        if char in " \t":
-            index += 1
