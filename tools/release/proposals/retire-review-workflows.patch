-VERDICT_LINE_TEXT_RE = re.compile(r"CODEX-THREAD:", re.IGNORECASE)
-RENDERED_HEAD_RE = re.compile(r"HEAD:\s*(?:[\w.-]+/[\w.-]+@)?([0-9a-f]{7,40})", re.IGNORECASE)
