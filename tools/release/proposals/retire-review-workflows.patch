+# Codex gate, the Claude fixer and the Codex mediator workflows are retired, and the gates are
+# reported by Lucas. No workflow may run a model writer or ask a model for a review again: none
+# may use the Claude Code action or its credentials, post `@codex review`, hold the mediator's
+# token or run its script, and the retired files stay gone.
+RETIRED_WORKFLOWS = ("codex-gate.yml", "claude.yml", "claude-conflict-writer.yml", "conflict-scan.yml",
+                     "stuck-thread-watch.yml")
+REVIEW_AUTOMATION = re.compile(r"anthropics/claude-code|ANTHROPIC_API_KEY|CLAUDE_CODE_OAUTH_TOKEN"
