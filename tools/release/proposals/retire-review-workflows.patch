-# trusted, model-free publish (mints the Claude App token, validates the one
-# merge commit and the outbox, pushes an ordinary fast-forward).
-name: Claude conflict writer
-
-on:
-  workflow_call:
-    inputs:
-      pr_number:
-        type: string
-        required: true
-      head_ref:
-        type: string
-        required: true
-      head_sha:
-        type: string
-        required: true
-      base_ref:
-        type: string
-        required: true
-    secrets:
-      CLAUDE_CODE_OAUTH_TOKEN:
